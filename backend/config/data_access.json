{
  "version": 4,
  "components": {
    "KpiRow": {
      "props": {
        "data": {
          "from": "metrics",
          "transform": "items",
          "arity": "array",
          "shape": "KpiItem[]",
          "type_info": {"type": "array", "items": "KpiItem"}
        }
      }
    },
    "Timeseries": {
      "props": {
        "data": {
          "from": "timeseries_metric",
          "transform": "wrap",
          "arity": "scalar→array",
          "shape": "Point[]",
          "type_info": {"type": "array", "items": "Point"}
        },
        "title": {
          "from": "chartTitle",
          "default": "Trend",
          "arity": "scalar",
          "type_info": {"type": "string"}
        }
      }
    },
    "AnalyticsTable": {
      "props": {
        "columns": {
          "from": "columns",
          "arity": "array",
          "type_info": {"type": "array", "items": "string"}
        }
      }
    },
    "MetricCard": {
      "props": {
        "value": {
          "from": "metric",
          "transform": "value",
          "arity": "scalar",
          "type_info": {"type": "object"}
        },
        "label": {
          "from": "metric",
          "transform": "label",
          "arity": "scalar",
          "type_info": {"type": "object"}
        }
      }
    },
    "FilterPanel": {
      "props": {}
    },
    "Embed": {
      "props": {
        "src": {
          "from": "src",
          "transform": "identity",
          "arity": "scalar",
          "type_info": {"type": "string"}
        },
        "title": {
          "from": "title",
          "transform": "identity",
          "default": "Embedded content",
          "arity": "scalar",
          "type_info": {"type": "string"}
        }
      }
    },
    "SearchBar": {
      "props": {
        "placeholder": {
          "from": "placeholder",
          "default": "Search...",
          "arity": "scalar",
          "type_info": {"type": "string"}
        }
      }
    },
    "Form": {
      "props": {
        "fields": {
          "from": "fields",
          "transform": "identity",
          "arity": "array",
          "type_info": {"type": "array", "items": "object"}
        }
      }
    },
    "ExportButton": {
      "props": {
        "format": {
          "from": "format",
          "default": "csv",
          "arity": "scalar",
          "type_info": {"type": "string"}
        }
      }
    },
    "Drilldown": {
      "props": {
        "label": {
          "from": "label",
          "default": "View details",
          "arity": "scalar",
          "type_info": {"type": "string"}
        },
        "target": {
          "from": "target",
          "transform": "identity",
          "arity": "scalar",
          "type_info": {"type": "string"}
        }
      }
    }
  },
  "composition": {
    "Page": {
      "dataSource": {
        "type": "dashboard_data",
        "hook": {
          "name": "useDashboardData",
          "import": "@/hooks/useDashboardData"
        },
        "slices": [
          {
            "component": "KpiRow",
            "targetProp": "data",
            "selector": "kpiData",
            "consumes": ["metrics"]
          },
          {
            "component": "Timeseries",
            "targetProp": "data",
            "selector": "chartData.timeseries",
            "consumes": ["timeseries_metric"]
          },
          {
            "component": "BarChart",
            "targetProp": "data",
            "selector": "chartData.barChart",
            "consumes": []
          },
          {
            "component": "AnalyticsTable",
            "targetProp": "data",
            "selector": "tableData",
            "consumes": []
          },
          {
            "component": "FilterPanel",
            "targetProp": "filters",
            "selector": "filters",
            "consumes": []
          }
        ]
      }
    }
  }
}
