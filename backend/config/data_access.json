{
  "version": 3,
  "components": {
    "Page": {
      "dataSource": {
        "type": "dashboard_data",
        "slices": [
          {
            "component": "KpiRow",
            "targetProp": "data",
            "selector": "kpiData",
            "consumes": ["metrics"]
          },
          {
            "component": "Timeseries",
            "targetProp": "data",
            "selector": "chartData.timeseries",
            "consumes": ["timeseries_metric"]
          }
        ]
      }
    }
  }
}
