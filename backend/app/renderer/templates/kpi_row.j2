import React from 'react';

interface KpiRowProps {
  metrics: string[];
}

export const KpiRow: React.FC<KpiRowProps> = ({ metrics }) => {
  return (
    <div className="kpi-row">
      {% for metric in metrics %}
      <div className="kpi-card">
        <span className="kpi-label">{__METRIC__}</span>
      </div>
      {% endfor %}
    </div>
  );
};
