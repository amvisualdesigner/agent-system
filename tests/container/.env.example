# ── Docker Compose ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=agent-system

# ── LLM (vllm) ─────────────────────────────────────────────
LLM_BASE_URL=http://localhost:7000
LLM_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
LLM_API_KEY=not-needed

# ── Backend API ─────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ── Orchestrator API ────────────────────────────────────────
ORCHESTRATOR_URL=http://localhost:9000

# ── UI ──────────────────────────────────────────────────────
UI_URL=http://localhost:5173

# ── Paths ───────────────────────────────────────────────────
REPO_ROOT=/opt/agent-repos/agent-test-repo
RUNS_DIR=/tmp/opencode/runs
ARTIFACTS_DIR=/tmp/opencode/artifacts
