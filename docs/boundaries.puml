@startuml
!pragma layout smetana
!theme plain
skinparam backgroundColor #fafafa
skinparam shadowing false
skinparam defaultFontName Fira Code
skinparam defaultFontSize 11
skinparam packageBorderColor #333333
skinparam rectangleBorderColor #333333
skinparam rectangleBorderThickness 2
skinparam arrowColor #555555
skinparam arrowThickness 2

title Fronteras de Responsabilidad

' ============================================================
' PAQUETES
' ============================================================
package "Intención" as INTENT #FFF3CD {
  rectangle "capability_catalog.json" as CAT
  rectangle "IntentInterpreter\n(LLM)" as II

  note right of CAT
    Sinónimos, labels UI,
    ejemplos, composition_map
    NO lee disco
    NO decide lifecycle
  end note
}

package "Realidad" as REALITY #F8D7DA {
  rectangle "StructuralIndex" as SI
  rectangle "complete_structure()" as CS

  note right of SI
    exists(cap)
    resolve_path()
    scan worktree
    NO verbos
    NO LLM
  end note
}

package "Plan" as PLAN #D4EDDA {
  rectangle "PlanCompiler" as PC

  note right of PC
    Determinista
    Sin LLM
    Sin StructuralIndex
    ConfirmedIntent + contrato
    → CompiledPlan
  end note
}

package "Ejecución" as EXEC #E8F4FD {
  rectangle "ApplyEngine" as AE
  rectangle "GraphIRBuilder" as GB
  rectangle "FileOpApplier" as FO
}

' ============================================================
' FLECHAS PROHIBIDAS (rojas)
' ============================================================
PC -[#FF0000]-> SI : PROHIBIDO\n(PlanCompiler no\nimporta index)
SI -[#FF0000]-> II : PROHIBIDO\n(Index no decide\nintención)
II -[#FF0000]-> CS : PROHIBIDO\n(Interpreter no\nconcilla lifecycle)

' ============================================================
' FLUJO CANÓNICO (verde)
' ============================================================
II -[#008000]-> PC : ConfirmedIntent
PC -[#008000]-> AE : CompiledPlan
SI -[#008000]-> AE : repo_snapshot
AE -[#008000]-> CS : intent + index
CS -[#008000]-> AE : StructuralIR\n(CREATE/MODIFY/DELETE/KEEP)
AE -[#008000]-> GB : StructuralIR
GB -[#008000]-> FO : FileOp[]

legend bottom
  <#FFF3CD> <b>Intención</b> — qué quiere el usuario
  <#F8D7DA> <b>Realidad</b> — qué hay en disco
  <#D4EDDA> <b>Plan</b> — determinista, puro
  <#E8F4FD> <b>Ejecución</b> — mezcla intención + realidad

  <b>Regla de oro:</b>
  ApplyEngine es el ÚNICO mezclador.
  Ningún otro componente importa ambos mundos.
endlegend

@enduml
